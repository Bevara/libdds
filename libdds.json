{
    "name": "libdds",
    "version": "1.0.2",
    "description": "DDS (DirectDraw Surface) decoder",
    "filters":["ddsdec"],
    "help": "This filter decodes BC1 to BC7 compressed DDS textures using bcdec.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libdds.accessor",
    "filter_source":{
        "ddsdec" : "dec_dds.c"
    },
    "extension":{
      "dds" : "img"
    },
    "using": ["mm_solver_minimal_1.0.1", "mm_solver_1.0.1"],
    "patents": {
        "status": "expired",
        "note": "S3TC/BCn texture compression",
        "checked": "2026-10-16"
    }
}
